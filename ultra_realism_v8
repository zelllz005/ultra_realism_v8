local TONE = {Neutral = {c = 0, s = 0, e = 0, t = 0}, Filmic = {c = 0.06, s = -0.02, e = 0.05, t = 0.05},
	Punchy = {c = 0.14, s = 0.1, e = 0, t = -0.05}, Soft = {c = -0.04, s = -0.03, e = 0.08, t = 0.1}}
local GRADE = {None = {c = 0, s = 0, t = {1, 1, 1}}, ["Warm Film"] = {c = 0.05, s = 0.05, t = {1, 0.96, 0.9}},
	["Cool Steel"] = {c = 0.08, s = -0.05, t = {0.93, 0.98, 1.04}}, Bleach = {c = 0.2, s = -0.3, t = {1, 1, 1}}, Vivid = {c = 0.08, s = 0.18, t = {1, 1, 1}}}
local function Resolve()
	local P = {}
	for k, v in pairs(S.era == "Custom" and CU or ERA[S.era]) do P[k] = v end
	local se, td, wx = SEAS[S.season], TOD[S.tod], WX[S.weather]
	P.tintR *= se.t[1]; P.tintG *= se.t[2]; P.tintB *= se.t[3]
	P.sat += se.sat + td.sat + wx.sat
	local tn, gr = TONE[S.tone] or TONE.Neutral, GRADE[S.grade] or GRADE.None
	P.contrast += tn.c + gr.c; P.sat += tn.s + gr.s; P.exposure += tn.e; P.bthr += tn.t
	P.tintR *= gr.t[1]; P.tintG *= gr.t[2]; P.tintB *= gr.t[3]
	P.exposure += td.exp + wx.exp
	P.bloom *= td.bloom; P.fog *= td.fog * wx.fog; P.haze += wx.haze; P.glare *= wx.glare; P.rays *= wx.rays
	P.contrast += wx.con; P.spec += wx.spec; P.wtF += wx.wet
	P.tintR += (td.warm + wx.warm) * 0.05 - wx.cool * 0.03
	P.tintB += -(td.warm + wx.warm) * 0.07 + wx.cool * 0.03
	for _, s in ipairs({"R", "G", "B"}) do
		P["amb" .. s] *= td.amb * wx.amb
		P["sun" .. s] *= td.sun * wx.sun
	end
	if td.clock then P.clock = td.clock end
	local I = U.intensity
	for k, nv in pairs(N0) do if P[k] then P[k] = nv + (P[k] - nv) * I end end
	P.exposure += U.exposure; P.contrast += U.contrast; P.sat += U.sat
	P.bloom *= U.bloom; P.haze *= U.haze; P.glare *= U.glare; P.shadow *= U.shadow; P.rays *= U.rays; P.spec += U.spec
	P.tintR += U.warmth * 0.05; P.tintB -= U.warmth * 0.07
	for k, v in pairs(P) do
		if k ~= "clock" then local r = RG[k] or {0, 1}; P[k] = math.clamp(v, r[1], r[2]) end
	end
	return P
end

