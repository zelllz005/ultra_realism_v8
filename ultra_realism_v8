local function Slider(pg, text, tbl, key, mn, mx, step, after)
	local f = N("Frame", {Size=UDim2.new(1,0,0,RH+16), BackgroundColor3=PANEL}, pg)
	corner(f, 8)
	label(f, text, 13, TXT, nil, nil, {Size=UDim2.new(1,-84,0,22), Position=UDim2.fromOffset(12,4)})
	local val = label(f, "", 12, GOLD, FONTB, Enum.TextXAlignment.Right, {Size=UDim2.fromOffset(66,22), Position=UDim2.new(1,-78,0,4)})
	local hit = btn(f, {Size=UDim2.new(1,-24,0,RH-8), Position=UDim2.fromOffset(12,28), BackgroundTransparency=1, Text=""})
	local bar = N("Frame", {Size=UDim2.new(1,0,0,4), Position=UDim2.new(0,0,0.5,-2), BackgroundColor3=OFF, BorderSizePixel=0}, hit)
	corner(bar, 2)
	local fill = N("Frame", {Size=UDim2.fromScale(0,1), BackgroundColor3=GOLD, BorderSizePixel=0}, bar)
	corner(fill, 2)
	local knob = N("Frame", {Size=UDim2.fromOffset(16,16), AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0,0.5), BackgroundColor3=Color3.new(1,1,1)}, bar)
	corner(knob, 8)
	local dec = step >= 1 and 0 or (step >= 0.1 and 1 or 2)
	local function vis()
		local r = math.clamp((tbl[key] - mn) / (mx - mn), 0, 1)
		fill.Size, knob.Position = UDim2.fromScale(r, 1), UDim2.fromScale(r, 0.5)
		val.Text = string.format("%." .. dec .. "f", tbl[key])
	end
	local drag, sc = false, nil
	local function setx(x)
		local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		tbl[key] = math.clamp(math.floor((mn + r * (mx - mn)) / step + 0.5) * step, mn, mx)
		vis()
		if after then after() else Refresh(false) end
	end
	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			drag = true
			sc = f:FindFirstAncestorWhichIsA("ScrollingFrame")
			if sc then sc.ScrollingEnabled = false end -- no accidental page scroll while dragging
			setx(i.Position.X)
		end
	end)
	conn(UIS.InputChanged:Connect(function(i) if drag and isMove(i) then setx(i.Position.X) end end))
	conn(UIS.InputEnded:Connect(function(i) if drag and isPress(i) then drag = false; if sc then sc.ScrollingEnabled = true end end end))
	reg[#reg + 1] = vis; vis()
end
local function Choice(pg, title, key, opts, per, after)
	if title then label(pg, title, 12, SUB, FONTM, nil, {Size=UDim2.new(1,0,0,18)}) end
	local bs = {}
	for i = 1, #opts, per do
		local row = N("Frame", {Size=UDim2.new(1,0,0,RH-2), BackgroundTransparency=1}, pg)
		N("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder}, row)
		for j = i, math.min(i + per - 1, #opts) do
			local o = opts[j]
			local b = btn(row, {Size=UDim2.new(1/per, -6*(per-1)/per, 1, 0), BackgroundColor3=PANEL, Text=o, Font=FONTM, TextSize=12, TextColor3=TXT, TextWrapped=true})
			corner(b, 8)
			bs[o] = b
			b.MouseButton1Click:Connect(function() S[key] = o; after(); refreshAll() end)
		end
	end
	reg[#reg + 1] = function() for o, b in pairs(bs) do local on = S[key] == o; tw(b, {BackgroundColor3 = on and GOLD or PANEL, TextColor3 = on and DARK or TXT}) end end
	reg[#reg]()
end
