	end

	-- 3D cumulus cloud field: clusters of overlapping spheres, sun-lit colour, wind drift, wrap-around, one BulkMoveTo at 10 Hz
	local R = 1600
	local CS = {Cumulus = {w = 1, h = 1, dark = 0}, Stratus = {w = 1.7, h = 0.4, dark = 0.05}, Storm = {w = 1.3, h = 1.4, dark = 0.4}}
	X.CS = CS
	local cfold = Instance.new("Folder"); cfold.Name = "TERA_Clouds3D"; cfold.Parent = cam; extra[#extra + 1] = cfold
	local CL, CP, CF = {}, {}, {}
	local cloudBase, needBuild, buildAt = 0, false, 0
	local rng = Random.new(os.time())
	local LIGHTC, DARKC, STORMC = Color3.fromRGB(246, 247, 250), Color3.fromRGB(168, 176, 194), Color3.fromRGB(72, 70, 78)
	local WARMC, NIGHTC = Color3.fromRGB(255, 190, 140), Color3.fromRGB(58, 66, 96)
	local function sunTone()
		local sy = Lighting:GetSunDirection().Y
		return (sy > -0.12) and math.clamp(1 - sy / 0.45, 0, 1) or 0, math.clamp(-sy * 4, 0, 1)
	end
	local function cloudLook()
		local warm, night = sunTone()
		if clouds and S.enabled then
			clouds.Color = Color3.new(1, 1, 1):Lerp(WARMC, warm * 0.5):Lerp(Color3.fromRGB(70, 76, 100), night * 0.7)
		end
		if #CP == 0 then return end
		local st = CS[S.cloudStyle] or CS.Cumulus
		for _, c in ipairs(CL) do
			for _, p in ipairs(c.puffs) do
				p.part.Color = DARKC:Lerp(LIGHTC, p.shade):Lerp(STORMC, st.dark):Lerp(WARMC, warm * 0.55):Lerp(NIGHTC, night * 0.6)
				p.part.Transparency = math.clamp(S.cloudSoft + p.edge * 0.3, 0, 0.95)
			end
		end
	end
	local function clearClouds() cfold:ClearAllChildren(); table.clear(CL); table.clear(CP); table.clear(CF) end
	local function stepClouds(dt)
		if #CL == 0 then return end
		local cp = cam.CFrame.Position
		local wd = math.rad(S.windDir)
		local vx, vz = math.cos(wd) * S.windSpd, math.sin(wd) * S.windSpd
		local y0, k = cloudBase + S.cloudAlt, 0
		for _, c in ipairs(CL) do
			c.x += vx * dt; c.z += vz * dt
			local dx, dz = c.x - cp.X, c.z - cp.Z
			if dx > R then c.x -= 2 * R elseif dx < -R then c.x += 2 * R end
			if dz > R then c.z -= 2 * R elseif dz < -R then c.z += 2 * R end
			for _, p in ipairs(c.puffs) do
				k += 1
				CF[k] = CFrame.new(c.x + p.ox, y0 + c.yo + p.oy, c.z + p.oz)
			end
		end
		if not pcall(workspace.BulkMoveTo, workspace, CP, CF, Enum.BulkMoveMode.FireCFrameChanged) then
			for i = 1, k do CP[i].CFrame = CF[i] end
		end
	end
	local function buildClouds()
		clearClouds()
		local n = (S.enabled and S.cloudsOn) and math.floor(Qe().cl * S.cloudCover) or 0
		if n < 1 then return end
		local cp = cam.CFrame.Position
		cloudBase = cp.Y
		local st = CS[S.cloudStyle] or CS.Cumulus
		for i = 1, n do
			local c = {x = cp.X + rng:NextNumber(-R, R), z = cp.Z + rng:NextNumber(-R, R), yo = rng:NextNumber(-30, 60), puffs = {}}
			local base = rng:NextNumber(110, 190) * S.cloudScale * st.w
			for j = 1, rng:NextInteger(6, 10) do
				local ang, rad = rng:NextNumber(0, 6.283), rng:NextNumber(0, base * 1.1)
				local k = 1 - rad / (base * 1.3) -- 1 at the centre of the cloud, 0 at the rim
				local sz = rng:NextNumber(0.55, 1) * base * (0.45 + k * 0.7)
				local part = Instance.new("Part")
				part.Shape, part.Size, part.Material = Enum.PartType.Ball, Vector3.new(sz, sz, sz), Enum.Material.SmoothPlastic
				part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
				part.Parent = cfold
				c.puffs[#c.puffs + 1] = {part = part, ox = math.cos(ang) * rad, oz = math.sin(ang) * rad * 0.7,
					oy = k * base * 0.32 * st.h + rng:NextNumber(-8, 8), shade = math.clamp(0.25 + k * 0.75, 0, 1), edge = 1 - k}
				CP[#CP + 1] = part
			end
			CL[#CL + 1] = c
		end
		cloudLook(); stepClouds(0)
	end
	X.buildClouds, X.clearClouds, X.cloudLook = buildClouds, clearClouds, cloudLook
	X.schedBuild = function() needBuild = true; buildAt = os.clock() + 0.5 end

	-- light manager: real shadows on the nearest lights + warm lantern tint/boost at night (originals restored)
	local lights, lightO = setmetatable({}, {__mode = "k"}), setmetatable({}, {__mode = "k"})
	local lscanned
	local WARM = Color3.fromRGB(255, 176, 100)
	local function trackLight(l) if l:IsA("PointLight") or l:IsA("SpotLight") or l:IsA("SurfaceLight") then lights[l] = true end end
	local function startLights()
		if lscanned then return end
		lscanned = true
		conn(workspace.DescendantAdded:Connect(trackLight))
		task.spawn(function()
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				trackLight(d); n += 1
				if n % 800 == 0 then task.wait() end
			end
		end)
	end
	local function lightPos(l)
		local p = l.Parent
		if p then
			if p:IsA("BasePart") then return p.Position elseif p:IsA("Attachment") then return p.WorldPosition end
		end
	end
	local function restoreLights()
		for l, o in pairs(lightO) do pcall(function() l.Shadows, l.Color, l.Brightness = o[1], o[2], o[3] end) end
		table.clear(lightO)
	end
	local function stepLights()
		local Q = Qe()
		local active = S.enabled and ((S.lightSh and Q.lights > 0) or S.lantWarm > 0 or S.lantBoost > 1)
		if not active then if next(lightO) then restoreLights() end return end
		startLights()
		local cp = cam.CFrame.Position
		local near, inNear = {}, {}
		local k = math.clamp((0.2 - Lighting:GetSunDirection().Y) / 0.3, 0, 1) -- 0 by day, 1 at night
		for l in pairs(lights) do
			local pos = l.Parent and l.Enabled and lightPos(l)
			if pos then
				local d = (pos - cp).Magnitude
				if d < 220 then near[#near + 1] = {l, d} end
			end
		end
		table.sort(near, function(a, b) return a[2] < b[2] end)
		local shadowN = S.lightSh and math.min(Q.lights, S.maxLights) or 0
		for i, e in ipairs(near) do
			local l = e[1]
			inNear[l] = true
			local o = lightO[l]
			if not o then o = {l.Shadows, l.Color, l.Brightness}; lightO[l] = o end
			l.Shadows = (i <= shadowN) or o[1]
			l.Color = o[2]:Lerp(WARM, S.lantWarm * k)
			l.Brightness = o[3] * (1 + (S.lantBoost - 1) * k)
		end
		for l, o in pairs(lightO) do
			if not inNear[l] then pcall(function() l.Shadows, l.Color, l.Brightness = o[1], o[2], o[3] end); lightO[l] = nil end
		end
	end
	X.stepLights, X.restoreLights = stepLights, restoreLights

	-- glossy surfaces: raises Reflectance on stone-like materials (originals stored, restored on off)
	local GLM, GLX = {}, {}
	for _, m in ipairs({"Concrete", "Cobblestone", "Pavement", "Asphalt", "Slate", "Marble", "Granite", "Brick", "Basalt", "Limestone", "Sandstone"}) do
		local ok, e = pcall(function() return Enum.Material[m] end)
		if ok and e then GLM[e] = true end
	end
	for _, m in ipairs({"Glass", "Metal", "DiamondPlate", "CorrodedMetal", "Foil"}) do
		local ok, e = pcall(function() return Enum.Material[m] end)
		if ok and e then GLX[e] = true end
	end
	local glossO, gconn, gGen = setmetatable({}, {__mode = "k"}), nil, 0
	local function gTarget(p)
		local a = S.glossAmt + ((S.weather == "Rain") and 0.08 or 0)
		return GLX[p.Material] and math.min(a * 1.8, 0.6) or a
	end
	local function glossPart(p)
		if p:IsA("BasePart") and not p:IsA("Terrain") and (GLM[p.Material] or GLX[p.Material]) then
			if glossO[p] == nil then glossO[p] = p.Reflectance end
			p.Reflectance = math.max(glossO[p], gTarget(p))
		end
	end
	local function glossOff()
		gGen += 1
		if gconn then gconn:Disconnect(); gconn = nil end
		for p, o in pairs(glossO) do pcall(function() p.Reflectance = o end) end
		table.clear(glossO)
	end
	local function glossOn()
		glossOff()
		if not (S.enabled and S.gloss and Qe().gloss) then return end
		local gen = gGen
		gconn = workspace.DescendantAdded:Connect(function(d) task.defer(glossPart, d) end)
		task.spawn(function()
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				if gen ~= gGen then return end
				glossPart(d); n += 1
				if n % 500 == 0 then task.wait() end
			end
		end)
	end
	X.glossOn, X.glossOff = glossOn, glossOff
	X.glossUpdate = function() for p, o in pairs(glossO) do p.Reflectance = math.max(o, gTarget(p)) end end

	-- camera: movement (head bob, lean, landing, speed FOV, zoom, orbit) + motion blur + breathing; one render-step bind only while needed
	local camBound, lastLook = false, Vector3.new(0, 0, 1)
	local fovBase, fovSet, fovD, zoomT, zoomCur = nil, nil, 0, 0, 0
	local phase, tiltCur, landOff, wasAir, lastVy, orbA, prevType = 0, 0, 0, false, 0, 0, nil
	local function camNeeded()
		return S.enabled and (S.mblur or S.sway or S.bob or S.tilt or S.landing or S.speedFov or S.orbit or zoomT > 0 or zoomCur > 0.001)
	end
	local function camStep(dt)
		cam = workspace.CurrentCamera
		local cf0 = cam.CFrame
		local look = cf0.LookVector
		if S.mblur and Qe().mb then
			local ang = math.acos(math.clamp(look:Dot(lastLook), -1, 1)) / math.max(dt, 1e-3)
			blur.Size += (math.clamp(ang * 1.2, 0, 8) - blur.Size) * math.min(dt * 10, 1)
		elseif blur.Size > 0 then blur.Size = 0 end
		lastLook = look
		local ch = lp.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local vel = root and root.AssemblyLinearVelocity or Vector3.zero
		local hv = Vector3.new(vel.X, 0, vel.Z)
		local speed = hv.Magnitude
		local air = (hum and hum.FloorMaterial == Enum.Material.Air) or false
		if S.orbit and root then -- cinematic orbit around the character
			if cam.CameraType ~= Enum.CameraType.Scriptable then prevType = prevType or cam.CameraType; cam.CameraType = Enum.CameraType.Scriptable end
			orbA += dt * S.orbitSpd
			local c = root.Position + Vector3.new(0, 1.5, 0)
			cam.CFrame = CFrame.lookAt(c + Vector3.new(math.cos(orbA) * S.orbitDist, 3.5, math.sin(orbA) * S.orbitDist), c)
		else
			if prevType then cam.CameraType = prevType; prevType = nil end
			if cam.CameraType == Enum.CameraType.Custom then
				local off = CFrame.identity
				if S.bob and root and not air then
					phase += dt * speed * 0.6
					local a = math.clamp(speed / 16, 0, 1.3) * S.bobAmt
					off *= CFrame.new(math.cos(phase) * 0.05 * a, math.abs(math.sin(phase)) * 0.09 * a - 0.04 * a, 0) * CFrame.Angles(0, 0, math.cos(phase) * 0.004 * a)
				end
				if S.tilt and root then
					tiltCur += (-hv:Dot(cf0.RightVector) / 16 * 0.035 * S.tiltAmt - tiltCur) * math.min(dt * 6, 1)
					off *= CFrame.Angles(0, 0, tiltCur)
				end
				if S.landing and hum then
					if wasAir and not air and lastVy < -22 then landOff = -math.clamp(-lastVy / 70, 0.25, 1) * 0.7 end
					landOff += (0 - landOff) * math.min(dt * 7, 1)
					off *= CFrame.new(0, landOff, 0)
				end
				if S.sway then
					local t = os.clock()
					off *= CFrame.Angles(math.sin(t * 0.7) * 0.0025, math.cos(t * 0.5) * 0.0025, math.sin(t * 0.4) * 0.0015)
				end
				cam.CFrame = cf0 * off
			end
		end
		wasAir, lastVy = air, vel.Y
		if S.speedFov or zoomT > 0 or zoomCur > 0.001 then -- FOV: speed kick + hold-to-zoom, never fights the game's own FOV changes
			if fovSet == nil or math.abs(cam.FieldOfView - fovSet) > 1e-3 then fovBase = cam.FieldOfView end
			fovD += ((S.speedFov and math.clamp((speed - 8) / 24, 0, 1) * 9 or 0) - fovD) * math.min(dt * 5, 1)
			zoomCur += (zoomT - zoomCur) * math.min(dt * 8, 1)
			local f = fovBase + fovD
			fovSet = math.clamp(f + (S.zoomFov - f) * zoomCur, 5, 120)
			cam.FieldOfView = fovSet
		elseif fovSet then cam.FieldOfView = fovBase; fovSet = nil; fovD = 0 end
		if not camNeeded() then X.syncCam() end
	end
	X.syncCam = function()
		local need = camNeeded()
		if need and not camBound then
			RS:BindToRenderStep("TERA_Cam", Enum.RenderPriority.Camera.Value + 1, camStep); camBound = true
		elseif not need and camBound then
			pcall(function() RS:UnbindFromRenderStep("TERA_Cam") end); camBound = false; blur.Size = 0
			if fovSet then cam.FieldOfView = fovBase; fovSet = nil; fovD = 0 end
			if prevType then cam.CameraType = prevType; prevType = nil end
		end
		blur.Enabled = S.enabled and S.mblur and true or false
	end
	X.zoom = function(on) zoomT = on and 1 or 0; X.syncCam() end
	X.Bars = function()
		local sz = UDim2.new(1, 0, (S.enabled and S.bars) and 0.11 or 0, 0)
		TS:Create(barT, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {Size = sz}):Play()
		TS:Create(barB, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {Size = sz}):Play()
	end

	-- dynamic camera-aware effects: sun-facing glare, indoor eye adaptation, auto-focus, underwater look
	local tgt = {exp = 0, bloom = 1, rays = 1, glare = 1, uw = 0, focus = 60, radius = 54}
	local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.IgnoreWater = true
	local function underwater(cp)
		if not terrain then return false end
		local ok, res = pcall(function()
			local cell = terrain:WorldToCell(cp)
			local c = terrain:CellCenterToWorld(cell.X, cell.Y, cell.Z)
			local m = terrain:ReadVoxels(Region3.new(c - Vector3.new(2, 2, 2), c + Vector3.new(2, 2, 2)), 4)
			return m[1][1][1] == Enum.Material.Water
		end)
		return ok and res
	end
	X.tick5 = function() -- 5 Hz: sample the scene
		X.rp = rp
		cam = workspace.CurrentCamera
		local cf = cam.CFrame
		local cp = cf.Position
		local ch = lp.Character
		rp.FilterDescendantsInstances = ch and {ch} or {}
		local sd = Lighting:GetSunDirection()
		local roof = workspace:Raycast(cp, Vector3.new(0, 90, 0), rp) ~= nil
		local indoor = S.eyeAdapt and roof
		X.indoor = roof
		local vis = 0
		if sd.Y > 0.02 and not indoor then vis = X.sampleSun(cp, sd) end -- 0..1 share of the sun disc that is unblocked
		X.vis = vis
		local f = S.sunGlare and (math.max(0, cf.LookVector:Dot(sd)) ^ 5 * vis) or 0
		tgt.bloom, tgt.rays, tgt.glare = 1 + f * 0.9, 1 + f * 1.4, 1 + f * 1.6
		tgt.exp = S.autoExp and -0.3 * f or 0 -- pull exposure down when staring at the sun
		if indoor then tgt.exp, tgt.rays, tgt.glare = 0.3, 0.2, 0.4 end
		tgt.uw = (S.uw and underwater(cp)) and 1 or 0
		if S.autoFocus and Qe().af then
			local hit = workspace:Raycast(cp, cf.LookVector * 500, rp)
			local d = hit and (hit.Position - cp).Magnitude or 500
			tgt.focus, tgt.radius = d, math.max(12, d * 0.35)
		else
			tgt.focus, tgt.radius = S.focusDist, S.focusDist * 0.9
		end
	end
	X.tick10 = function(dt) -- 10 Hz: clouds, day cycle, ease dynamic values
		if S.cycle > 0 then Lighting.ClockTime = (Lighting.ClockTime + dt * S.cycle) % 24 end
		if needBuild and os.clock() >= buildAt then needBuild = false; buildClouds() end
		stepClouds(dt)
		local moved = false
		for k, v in pairs(tgt) do
			local d = v - dyn[k]
			if math.abs(d) > (k == "focus" and 0.3 or 0.003) then dyn[k] += d * 0.3; moved = true end
		end
		if moved and X.reapply then X.reapply() end
	end
	X.tick2 = function() cloudLook(); stepLights() end -- 0.5 Hz: cloud colours, lights
end

---------------------------------------------------------------- v5: lens flare, sun occlusion, contact shadows
do
	local lp = Players.LocalPlayer
	local JIT = {{0, 0}, {0.05, 0}, {-0.05, 0}, {0, 0.05}, {0, -0.05}}
	X.sampleSun = function(cp, sd) -- fraction of the sun disc not blocked by solid geometry (partial = trees)
		local right = sd:Cross(Vector3.yAxis)
		if right.Magnitude < 1e-3 then right = Vector3.xAxis end
		right = right.Unit
		local up = right:Cross(sd).Unit
		local open = 0
		for _, o in ipairs(JIT) do
			local hit = workspace:Raycast(cp, (sd + right * o[1] + up * o[2]).Unit * 500, X.rp)
			if not hit or (not hit.Instance:IsA("Terrain") and hit.Instance.Transparency >= 0.8) then open += 1 end
		end
		return open / #JIT
	end

	-- screen-space lens flare built from GUI shapes (no external assets)
	local fl = N("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 2}, ov)
	local EL = {}
	local function disc(kind, size, col, tr, ring, t)
		local f = Instance.new("Frame")
		f.AnchorPoint, f.Size, f.BorderSizePixel, f.BackgroundColor3 = Vector2.new(0.5, 0.5), UDim2.fromOffset(size, size), 0, col
		f.BackgroundTransparency = ring and 1 or tr
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0.5, 0); c.Parent = f
		local st
		if ring then st = Instance.new("UIStroke"); st.Color, st.Thickness, st.Transparency = col, ring, tr; st.Parent = f end
		f.Parent = fl
		EL[#EL + 1] = {kind = kind, f = f, st = st, tr = tr, size = size, t = t}
	end
	local function streak(w, h, rot, col, tr)
		local f = Instance.new("Frame")
		f.AnchorPoint, f.BorderSizePixel, f.BackgroundColor3, f.BackgroundTransparency, f.Rotation = Vector2.new(0.5, 0.5), 0, col, tr, rot
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1)})
		g.Parent = f
		f.Parent = fl
		EL[#EL + 1] = {kind = "streak", f = f, tr = tr, w = w, h = h}
	end
	local WARMW = Color3.fromRGB(255, 244, 225)
	for i, d in ipairs({{60, 0.78}, {140, 0.88}, {300, 0.94}, {640, 0.97}}) do disc("core", d[1], WARMW, d[2]) end
	disc("halo", 100, Color3.fromRGB(255, 235, 210), 0.9, 3)
	disc("ghost", 70, Color3.fromRGB(120, 200, 255), 0.88, nil, 0.35)
	disc("ghost", 40, Color3.fromRGB(255, 170, 90), 0.8, 2, 0.55)
	disc("ghost", 110, Color3.fromRGB(160, 255, 190), 0.86, 3, 0.8)
	disc("ghost", 60, Color3.fromRGB(255, 120, 160), 0.9, nil, 1.2)
	disc("ghost", 150, Color3.fromRGB(150, 170, 255), 0.88, 2, 1.6)
	disc("ghost", 90, Color3.fromRGB(255, 210, 140), 0.9, nil, 2.1)
	streak(0.9, 4, 0, Color3.fromRGB(190, 215, 255), 0.55)
	streak(0.5, 2, 32, Color3.fromRGB(255, 225, 190), 0.75)
	streak(0.5, 2, -32, Color3.fromRGB(255, 225, 190), 0.75)

	local vis, lastLook = 0, Vector3.new(0, 0, 1)
	local function flareStep(dt)
		local Q = Qe()
		local sd = Lighting:GetSunDirection()
		local cf = cam.CFrame
		local dotv = cf.LookVector:Dot(sd)
		if not (S.flare and S.enabled and Q.fl) or sd.Y < -0.04 or dotv < 0.1 then fl.Visible = false; lastLook = cf.LookVector return end
		local vp = cam.ViewportSize
		local p = cam:WorldToViewportPoint(cf.Position + sd * 1000)
		local pos, c = Vector2.new(p.X, p.Y), vp / 2
		vis += ((X.vis or 0) - vis) * math.min(dt * 6, 1)
		local ang = math.acos(math.clamp(cf.LookVector:Dot(lastLook), -1, 1)) / math.max(dt, 1e-3)
		lastLook = cf.LookVector
		local edge = 1 - math.clamp((pos - c).Magnitude / (vp.Magnitude * 0.6), 0, 1)
		local I = S.flareAmt * vis * edge * (math.clamp((dotv - 0.1) / 0.5, 0, 1) ^ 1.5) * (1 + math.min(ang * 0.12, 0.5)) * math.clamp((sd.Y + 0.04) / 0.1, 0, 1)
		if I < 0.01 then fl.Visible = false return end
		fl.Visible = true
		local u, v = vp.Y / 720, c - pos
		for _, e in ipairs(EL) do
			local k, f = e.kind, e.f
			if k == "core" then
				f.Position, f.Size = UDim2.fromOffset(pos.X, pos.Y), UDim2.fromOffset(e.size * u, e.size * u)
			elseif k == "ghost" then
				local a = pos + v * e.t
				f.Position, f.Size = UDim2.fromOffset(a.X, a.Y), UDim2.fromOffset(e.size * u, e.size * u)
			elseif k == "halo" then
				local d = v.Magnitude * 1.1 + 0.25 * vp.Y
				f.Position, f.Size = UDim2.fromOffset(c.X, c.Y), UDim2.fromOffset(d, d)
			else
				f.Position, f.Size = UDim2.fromOffset(pos.X, pos.Y), UDim2.fromOffset(vp.X * e.w, e.h * u)
			end
			local t = math.clamp(1 - (1 - e.tr) * math.min(I, 1.5), 0, 1)
			if e.st then e.st.Transparency = t else f.BackgroundTransparency = t end
		end
	end

	-- contact shadow: soft stacked discs under the character that fade as you leave the ground
	local sfold = Instance.new("Folder"); sfold.Name = "TERA_Contact"; sfold.Parent = cam; X.extra[#X.extra + 1] = sfold
	local CS3, CT = {}, {0.92, 0.85, 0.74}
	for i, d in ipairs({4.4, 3.2, 2.1}) do
		local p = Instance.new("Part")
		p.Shape, p.Size, p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = Enum.PartType.Cylinder, Vector3.new(0.05, d, d), true, false, false, false, false
		p.Material, p.Color, p.Transparency = Enum.Material.SmoothPlastic, Color3.new(0, 0, 0), 1
		p.Parent = sfold
		CS3[i] = p
	end
	local function hideContact() for _, p in ipairs(CS3) do p.Transparency = 1 end end
	local function contactStep()
		local ch = lp.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not (S.contact and S.enabled and Qe().cs and root and X.rp) then hideContact() return end
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), X.rp)
		if not hit then hideContact() return end
		local fade = math.clamp((root.Position.Y - hit.Position.Y - 3) / 7, 0, 1)
		local n = hit.Normal
		local vy = n:Cross(Vector3.xAxis)
		if vy.Magnitude < 0.1 then vy = n:Cross(Vector3.zAxis) end
		local base = CFrame.fromMatrix(hit.Position + n * 0.03, n, vy.Unit)
		local day = math.clamp(Lighting:GetSunDirection().Y * 4 + 0.5, 0.25, 1)
		for i, p in ipairs(CS3) do
			p.CFrame = base + n * (0.006 * i)
			p.Transparency = math.clamp(1 - (1 - CT[i]) * (1 - fade) * day, 0, 1)
		end
	end

	local fxBound = false
	X.syncFx = function()
		local need = S.enabled and (S.flare or S.contact)
		if need and not fxBound then
			RS:BindToRenderStep("TERA_Fx", Enum.RenderPriority.Camera.Value + 2, function(dt) cam = workspace.CurrentCamera; flareStep(dt); contactStep() end)
			fxBound = true
		elseif not need and fxBound then
			pcall(function() RS:UnbindFromRenderStep("TERA_Fx") end); fxBound = false
			fl.Visible = false; hideContact()
		end
	end
end

---------------------------------------------------------------- v8: weather particles + lens raindrops
do
	local pfold = Instance.new("Folder"); pfold.Name = "TERA_Particles"; pfold.Parent = cam; X.extra[#X.extra + 1] = pfold
	local PT = {
		Rain = {n = 170, size = Vector3.new(0.05, 0.05, 3.4), col = Color3.fromRGB(196, 210, 230), tr = 0.55, shape = Enum.PartType.Block, mat = Enum.Material.SmoothPlastic, box = 80},
		Snow = {n = 150, size = Vector3.new(0.4, 0.4, 0.4), col = Color3.fromRGB(246, 249, 255), tr = 0.12, shape = Enum.PartType.Ball, mat = Enum.Material.SmoothPlastic, box = 70},
		Dust = {n = 70, size = Vector3.new(0.14, 0.14, 0.14), col = Color3.fromRGB(255, 238, 205), tr = 0.55, shape = Enum.PartType.Ball, mat = Enum.Material.Neon, box = 34},
		Fireflies = {n = 34, size = Vector3.new(0.22, 0.22, 0.22), col = Color3.fromRGB(190, 255, 120), tr = 0.1, shape = Enum.PartType.Ball, mat = Enum.Material.Neon, box = 40},
	}
	X.PT = PT
	local rng = Random.new(os.time() + 7)
	local pool, parts, cfs, cfg, hb = {}, {}, {}, nil, nil
	local acc, tclock, parked, lastT = 0, 0, false, -1

	local LD = N("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3}, ov)
	local drops = {}
	for i = 1, 12 do
		local f = Instance.new("Frame")
		f.AnchorPoint, f.BorderSizePixel, f.BackgroundColor3, f.BackgroundTransparency, f.Visible = Vector2.new(0.5, 0.5), 0, Color3.new(1, 1, 1), 0.9, false
		local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0.5, 0); cr.Parent = f
		local st = Instance.new("UIStroke"); st.Color, st.Thickness, st.Transparency = Color3.new(1, 1, 1), 1.5, 0.5; st.Parent = f
		f.Parent = LD
		drops[i] = {f = f, st = st, born = 0, life = 1, x = 0, y = 0, on = false}
	end
	local function hideDrops() for _, e in ipairs(drops) do e.on = false; e.f.Visible = false end end
	local function dropsStep(d, active, vp)
		if active and rng:NextNumber() < d * 2.5 then
			for _, e in ipairs(drops) do
				if not e.on then
					e.on, e.born, e.life = true, tclock, rng:NextNumber(2, 3.6)
					e.x, e.y = rng:NextNumber(0.05, 0.95) * vp.X, rng:NextNumber(0.05, 0.9) * vp.Y
					local sz = rng:NextNumber(10, 30)
					e.f.Size = UDim2.fromOffset(sz, sz * 1.15)
					e.f.Visible = true
					break
				end
			end
		end
		for _, e in ipairs(drops) do
			if e.on then
				local a = (tclock - e.born) / e.life
				if a >= 1 or not active then e.on = false; e.f.Visible = false
				else
					e.y += d * 14
					e.f.Position = UDim2.fromOffset(e.x, e.y)
					local fade = a < 0.15 and a / 0.15 or (1 - a)
					e.f.BackgroundTransparency, e.st.Transparency = 1 - 0.1 * fade, 1 - 0.5 * fade
				end
			end
		end
	end

	local function step(dt)
		acc += dt
		if acc < 1 / 30 then return end
		local d = acc; acc = 0
		tclock += d
		local c = cfg
		if not c then return end
		local cf = workspace.CurrentCamera.CFrame
		local cp = cf.Position
		local half = c.box * 0.5
		local name = S.particles
		local roof = X.indoor and true or false
		if roof ~= parked then
			parked = roof; lastT = -1
			for i = 1, #parts do parts[i].Transparency = roof and 1 or c.tr end
		end
		dropsStep(d, name == "Rain" and S.lensDrops and Qe().fl and not parked, workspace.CurrentCamera.ViewportSize)
		if parked then return end
		local sy = Lighting:GetSunDirection().Y
		local wd = math.rad(S.windDir)
		local wx, wz = math.cos(wd) * S.windSpd * 0.3, math.sin(wd) * S.windSpd * 0.3
		for i, a in ipairs(pool) do
			local pos = a.pos
			if name == "Rain" then
				local vel = Vector3.new(wx, -88, wz)
				pos += vel * d
				cfs[i] = CFrame.lookAt(pos, pos + vel)
			elseif name == "Snow" then
				pos += Vector3.new(wx * 0.5 + math.sin(tclock * 0.9 + a.ph) * 1.2, -7, wz * 0.5 + math.cos(tclock * 0.7 + a.ph) * 1.2) * d
				cfs[i] = CFrame.new(pos)
			else
				local k = name == "Dust" and 0.5 or 1.4
				pos += (Vector3.new(math.sin(tclock * 0.5 + a.ph), math.sin(tclock * 0.37 + a.ph * 1.7) * 0.5, math.cos(tclock * 0.43 + a.ph * 0.6)) * k
					+ (name == "Dust" and Vector3.new(wx, 0, wz) * 0.15 or Vector3.zero)) * d
				cfs[i] = CFrame.new(pos)
			end
			local rel = pos - cp
			local rx, ry, rz = rel.X, rel.Y, rel.Z
			if rx > half then rx -= 2 * half elseif rx < -half then rx += 2 * half end
			if rz > half then rz -= 2 * half elseif rz < -half then rz += 2 * half end
			if ry < -half * 0.8 then ry += half * 1.6 elseif ry > half * 0.8 then ry -= half * 1.6 end
			if rx ~= rel.X or ry ~= rel.Y or rz ~= rel.Z then
				pos = cp + Vector3.new(rx, ry, rz)
				cfs[i] = cfs[i].Rotation + pos
			end
			a.pos = pos
			if name == "Fireflies" then
				local night = math.clamp(-sy * 4, 0, 1)
				parts[i].Transparency = 1 - (1 - c.tr) * night * (0.5 + 0.5 * math.sin(tclock * 2.2 + a.ph * 3))
			end
		end
		if name == "Dust" then -- motes only show in direct sun
			local t = 1 - (1 - c.tr) * math.clamp(sy * 3, 0, 1)
			if math.abs(t - lastT) > 0.02 then lastT = t; for i = 1, #parts do parts[i].Transparency = t end end
		end
		if not pcall(workspace.BulkMoveTo, workspace, parts, cfs, Enum.BulkMoveMode.FireCFrameChanged) then
			for i = 1, #parts do parts[i].CFrame = cfs[i] end
		end
	end

	local function clear()
		if hb then hb:Disconnect(); hb = nil end
		pfold:ClearAllChildren(); table.clear(pool); table.clear(parts); table.clear(cfs)
		cfg, parked, lastT = nil, false, -1
		hideDrops()
	end
	X.syncParts = function()
		clear()
		local c = PT[S.particles]
		local n = (S.enabled and c) and math.floor(c.n * S.partAmt * Qe().pf) or 0
		if n < 1 then return end
		cfg = c
		local cp = cam.CFrame.Position
		local half = c.box * 0.5
		for i = 1, n do
			local part = Instance.new("Part")
			part.Shape, part.Size, part.Material, part.Color, part.Transparency = c.shape, c.size, c.mat, c.col, c.tr
			part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
			part.Parent = pfold
			parts[i] = part
			local pos = cp + Vector3.new(rng:NextNumber(-half, half), rng:NextNumber(-half * 0.8, half * 0.8), rng:NextNumber(-half, half))
			pool[i] = {pos = pos, ph = rng:NextNumber(0, 6.28)}
			cfs[i] = CFrame.new(pos)
		end
		hb = RS.Heartbeat:Connect(step)
	end
	local tk = 0
	X.schedParts = function() tk += 1; local my = tk; task.delay(0.4, function() if tk == my then X.syncParts() end end) end
end

---------------------------------------------------------------- apply values to the game
local function ApplyVals(v)
	local Q = Qe()
	local uw = dyn.uw
	local sy = Lighting:GetSunDirection().Y
	local low = (sy > -0.15) and math.clamp(1 - sy / 0.5, 0, 1) or 0 -- 0 at noon, 1 at the horizon
	local night = math.clamp(-sy * 5, 0, 1)
	local tint = Color3.new(v.tintR, v.tintG, v.tintB)
	local acol, dcol = Color3.new(v.atR, v.atG, v.atB), Color3.new(v.dcR, v.dcG, v.dcB)
	if S.scatter then -- sun-angle atmospheric scattering: warm low sun, dark blue night
		acol = acol:Lerp(Color3.new(1, 0.68, 0.48), low * 0.5):Lerp(Color3.new(0.1, 0.14, 0.26), night * 0.85)
		dcol = dcol:Lerp(Color3.new(0.95, 0.45, 0.25), low * 0.65):Lerp(Color3.new(0.05, 0.07, 0.14), night)
	end
	local dens = v.fog * 0.7 * S.fogAmt
	if S.dawnMist then dens = dens * (1 + 1.1 * math.exp(-((Lighting.ClockTime - 6.4) ^ 2) / 2.5)) end -- thicker mist around sunrise
	dens = math.clamp(dens, 0, 0.75)
	if uw > 0.01 then -- underwater look
		tint = tint:Lerp(Color3.new(0.6, 0.88, 0.95), uw * 0.7)
		dens, acol = dens + (0.6 - dens) * uw, acol:Lerp(Color3.new(0.1, 0.38, 0.45), uw)
	end
	cc.TintColor, cc.Saturation, cc.Contrast, cc.Brightness = tint, v.sat, v.contrast, 0
	bloom.Intensity, bloom.Size, bloom.Threshold = v.bloom * dyn.bloom, v.bsize * Q.bs * 0.7, v.bthr
	local wide = S.bloomWide and Q.bs >= 0.75 -- second, wide bloom = smooth HDR falloff
	bloom2.Enabled = wide
	if wide then bloom2.Intensity, bloom2.Size, bloom2.Threshold = v.bloom * 0.5 * dyn.bloom, 52 * Q.bs, v.bthr + 0.12 end
	sun.Intensity = v.rays * Q.ray * dyn.rays * (1 - uw)
	dof.Enabled, dof.FarIntensity, dof.NearIntensity = S.dof and Q.dof, S.dofAmt, S.autoFocus and 0.12 or 0
	dof.FocusDistance, dof.InFocusRadius = dyn.focus, dyn.radius
	if S.fogMode == "Classic" then
		if atmo.Parent then atmo.Parent = nil end
		Lighting.FogColor, Lighting.FogStart = acol, S.fogDist * 0.08
		Lighting.FogEnd = math.max(120, S.fogDist / math.max(S.fogAmt, 0.3))
	else
		if atmo.Parent ~= Lighting then atmo.Parent = Lighting end
		atmo.Density, atmo.Offset, atmo.Haze, atmo.Glare = dens, 0.12 + v.fog * 0.3, v.haze, v.glare * dyn.glare
		atmo.Color, atmo.Decay = acol, dcol
		Lighting.FogEnd = 1e5
	end
	local depth = S.shadowDepth -- deeper shadows = lower sky fill, stronger sun key, cool shade tint
	local am = 1.25 - 0.55 * depth
	local ar, ag, ab = v.ambR * am, v.ambG * am, v.ambB * am
	Lighting.Brightness, Lighting.ExposureCompensation = v.brightness * (0.9 + 0.2 * depth), v.exposure + dyn.exp
	Lighting.OutdoorAmbient, Lighting.Ambient = Color3.new(ar, ag, ab), Color3.new(ar * 0.8, ag * 0.8, ab * 0.8)
	Lighting.ColorShift_Top = Color3.new(v.sunR + low * 0.10, v.sunG + low * 0.035, v.sunB)
	local day = 1 - night
	Lighting.ColorShift_Bottom = Color3.new(0.03 * depth * day, 0.05 * depth * day, 0.10 * depth * day)
	Lighting.GlobalShadows = true
	if has.ShadowSoftness then Lighting.ShadowSoftness = v.shadow * Q.sh end
	if has.EnvironmentSpecularScale then Lighting.EnvironmentSpecularScale = v.spec end
	if v.clock and S.cycle <= 0 then Lighting.ClockTime = v.clock end
	if canTech and last.tech ~= Q.fut then
		last.tech = Q.fut
		pcall(sethiddenproperty, Lighting, "Technology", Q.fut and Enum.Technology.Future or origTech)
	end
	local mat = Q.mat and S.pbr
	if origMat ~= nil and last.mat ~= mat then last.mat = mat; pcall(function() MS.Use2022Materials = mat end) end
	if terrain then
		if S.water then terrain.WaterColor, terrain.WaterTransparency, terrain.WaterReflectance = Color3.new(v.wtR, v.wtG, v.wtB), v.wtT, v.wtF
		elseif ow then terrain.WaterColor, terrain.WaterTransparency, terrain.WaterReflectance = ow.c, ow.t, ow.r end
	end
	local vg = Q.vig and S.vig > 0
	for _, g in ipairs(vigG) do g.Parent.Visible = vg end
	if vg and last.vig ~= S.vig then
		last.vig = S.vig
		local ng = NumberSequence.new({NumberSequenceKeypoint.new(0, 1 - S.vig * 0.85), NumberSequenceKeypoint.new(1, 1)})
		for _, g in ipairs(vigG) do g.Transparency = ng end
	end
	X.apply()
end
local function Reapply() if cur and S.enabled then ApplyVals(cur) end end
X.reapply = Reapply
X.qc = function() Reapply(); X.schedBuild(); X.schedParts(); X.glossOn(); X.stepLights() end
local function stopTr() if tr then tr:Disconnect(); tr = nil end end

local function Refresh(smooth) -- smooth = 1.2s eased transition (event-driven: connection lives only while it runs)
	if not S.enabled then return end
	stopTr()
	local tgt = Resolve()
	if not smooth or not cur then cur = tgt; ApplyVals(cur) return end
	for k in pairs(cur) do if tgt[k] == nil then cur[k] = nil end end
	local from = {}
	for k, v in pairs(cur) do from[k] = v end
	local t = 0
	tr = RS.Heartbeat:Connect(function(dt)
		t += dt / 1.2
		local e = t >= 1 and 1 or t * t * (3 - 2 * t)
		for k, v in pairs(tgt) do
			local f = from[k]
			cur[k] = f and (f + (v - f) * e) or v
		end
		ApplyVals(cur)
		if t >= 1 then stopTr() end
	end)
end

---------------------------------------------------------------- performance monitor (one light Heartbeat while enabled)
local mon
local function stopMon() if mon then mon:Disconnect(); mon = nil end end
local win -- window (assigned later)
local function startMon()
	if mon then return end
	local acc, frames, lowT, highT, a5, a10, a2 = 0, 0, 0, 0, 0, 0, 0
	mon = RS.Heartbeat:Connect(function(dt)
		acc += dt; frames += 1; a5 += dt; a10 += dt; a2 += dt
		if a10 >= 0.1 then X.tick10(a10); a10 = 0 end
		if a5 >= 0.2 then X.tick5(); a5 = 0 end
		if a2 >= 2 then X.tick2(); a2 = 0 end
		if acc < 1 then return end
		local fps, ms = frames / acc, acc / frames * 1000
		acc, frames = 0, 0
		local maxQ = table.find(QN, S.quality) or 3
		local eff = math.min(maxQ, autoCap)
		if S.autoperf and not S.lowPerf then
			if fps < S.target then lowT += 1; highT = 0
			elseif fps > S.target + 15 then highT += 1; lowT = 0
			else lowT, highT = 0, 0 end
			if lowT >= 4 and eff > 1 then autoCap = eff - 1; lowT = 0; X.qc(); notify("Auto-optimize: quality lowered")
			elseif highT >= 12 and autoCap < maxQ then autoCap += 1; highT = 0; X.qc(); notify("Auto-optimize: quality restored") end
			eff = math.min(maxQ, autoCap)
		end
		if perfL and win and win.Visible then perfL.Text = string.format("%d FPS  %.1f ms  %s", fps, ms, S.lowPerf and "Low*" or QN[eff]) end
	end)
end

local function Enable(on)
	S.enabled = on
	stopTr()
	if on then
		setGame(true)
		cc.Enabled, bloom.Enabled, sun.Enabled = true, true, true
		atmo.Parent = Lighting
		startMon()
		cur = nil
		Refresh(false)
		X.buildClouds(); X.syncParts(); X.syncCam(); X.syncFx(); X.Bars(); X.glossOn(); X.stepLights()
	else
		stopMon()
		X.clearClouds(); X.syncParts(); X.syncCam(); X.syncFx(); X.glossOff(); X.restoreLights(); X.Bars()
		cc.Enabled, bloom.Enabled, bloom2.Enabled, sun.Enabled, dof.Enabled = false, false, false, false, false
		atmo.Parent = nil
		setGame(false)
		for p, v in pairs(orig) do pcall(function() Lighting[p] = v end) end
		if canTech then pcall(sethiddenproperty, Lighting, "Technology", origTech) end
		if origMat ~= nil then pcall(function() MS.Use2022Materials = origMat end) end
		if terrain and ow then terrain.WaterColor, terrain.WaterTransparency, terrain.WaterReflectance = ow.c, ow.t, ow.r end
		X.restore()
		for _, g in ipairs(vigG) do g.Parent.Visible = false end
		last = {}
	end
end

---------------------------------------------------------------- config
local FILE = "TripleEraShader_config.json"
local function Save()
	if not writefile then notify("This executor has no writefile") return end
	local ok = pcall(function() writefile(FILE, HS:JSONEncode({S = S, U = U, CU = CU})) end)
	notify(ok and "Settings saved" or "Save failed")
end
local function Load()
	if not (isfile and readfile and isfile(FILE)) then return false end
	local ok, d = pcall(function() return HS:JSONDecode(readfile(FILE)) end)
	if not ok or type(d) ~= "table" then return false end
	for k, v in pairs(d.S or {}) do if DEFS[k] ~= nil and type(v) == type(DEFS[k]) then S[k] = v end end
	for k, v in pairs(d.U or {}) do if DEFU[k] ~= nil and type(v) == "number" then U[k] = v end end
	for k, v in pairs(d.CU or {}) do if type(v) == "number" and ERA.Medieval[k] ~= nil then CU[k] = v end end
	if not ERA[S.era] then S.era = DEFS.era end
	if not TOD[S.tod] then S.tod = DEFS.tod end
	if not WX[S.weather] then S.weather = DEFS.weather end
	if not SEAS[S.season] then S.season = DEFS.season end
	if not table.find(QN, S.quality) then S.quality = DEFS.quality end
	if not X.CS[S.cloudStyle] then S.cloudStyle = DEFS.cloudStyle end
	if S.fogMode ~= "Atmosphere" and S.fogMode ~= "Classic" then S.fogMode = DEFS.fogMode end
	if S.particles ~= "Off" and not X.PT[S.particles] then S.particles = DEFS.particles end
	if not TONE[S.tone] then S.tone = DEFS.tone end
	if not GRADE[S.grade] then S.grade = DEFS.grade end
	return true
end

