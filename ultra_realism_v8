end))
conn(UIS.InputEnded:Connect(function(i) if isPress(i) then dragW = false end end))
conn(UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightShift then setOpen(not open)
	elseif i.KeyCode == Enum.KeyCode.K then Enable(not S.enabled); refreshAll(); notify(S.enabled and "Shaders on" or "Shaders off - game restored")
	elseif i.KeyCode == Enum.KeyCode.Z then X.zoom(true) end
end))
conn(UIS.InputEnded:Connect(function(i) if i.KeyCode == Enum.KeyCode.Z then X.zoomOn = false; X.zoom(false) end end))

