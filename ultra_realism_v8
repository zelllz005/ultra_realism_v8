-- themes: swap the accent colour everywhere
local THEMES = {Gold = Color3.fromRGB(214,178,98), Ice = Color3.fromRGB(96,170,255), Emerald = Color3.fromRGB(88,200,140), Crimson = Color3.fromRGB(232,90,90), Violet = Color3.fromRGB(160,120,255)}
local function retheme()
	local new, old = THEMES[S.theme] or THEMES.Gold, GOLD
	if new == old then return end
	GOLD = new
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("GuiObject") then
			if d.BackgroundColor3 == old then d.BackgroundColor3 = new end
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.TextColor3 == old then d.TextColor3 = new end
			if d:IsA("ScrollingFrame") and d.ScrollBarImageColor3 == old then d.ScrollBarImageColor3 = new end
		elseif d:IsA("UIStroke") and d.Color == old then d.Color = new end
	end
	refreshAll()
end

