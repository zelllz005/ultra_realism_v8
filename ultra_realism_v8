local function layout()
	local vp = cam.ViewportSize
	local w, h = math.clamp(vp.X * 0.94, 340, 700), math.clamp(vp.Y * 0.9, 260, 460)
	if maxim then w, h = vp.X * 0.97, vp.Y * 0.94 end
	if minimized then h = 44 end
	local sw = w < 480 and 96 or 124
	side.Size = UDim2.new(0, sw, 1, 0)
	content.Position, content.Size = UDim2.fromOffset(sw + 8, 8), UDim2.new(1, -(sw + 16), 1, -16)
	body.Visible = not minimized
	tw(win, {Size = UDim2.fromOffset(w, h)}, 0.2)
end
